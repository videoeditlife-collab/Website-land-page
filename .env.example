# ============================================================================
#  Cross-Post Scheduler — backend environment variables
#  Set these in Netlify:  Site settings -> Environment variables
#  (Do NOT commit real values. This file is just a template.)
# ============================================================================

# --- TikTok (developers.tiktok.com -> your app -> Content Posting API) -------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Until your app passes TikTok's audit, posts must be SELF_ONLY.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Instagram / Meta (developers.facebook.com -> your app) ------------------
META_APP_ID=
META_APP_SECRET=

# --- Media storage: Supabase Storage, free tier -----------------------------
# Create a project, add a PUBLIC bucket (e.g. "media"), then copy these from
# Project settings -> API.  Use the service_role key (server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media

# --- Optional shared secret between the front end and backend ----------------
# If set, the app must send it as x-api-key (paste the same value in the app's
# connection panel). Leave blank for none.
API_KEY=

# --- Set automatically by Netlify; override only for local dev ---------------
# PUBLIC_URL=https://your-site.netlify.app
